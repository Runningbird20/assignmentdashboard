# Base URL of your Canvas instance (no trailing /api/v1).
CANVAS_API_URL=https://canvas.instructure.com

# Canvas personal access token (Account > Settings > New Access Token).
CANVAS_ACCESS_TOKEN=

# Slack Incoming Webhook URL. Leave blank to disable notifications.
SLACK_WEBHOOK_URL=

# SQLAlchemy database URL.
DATABASE_URL=sqlite:///canvas.db

# How often (in hours) the background sync runs.
SYNC_INTERVAL_HOURS=1
