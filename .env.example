# Copy to .env (used by docker compose) or backend/.env (used when running
# uvicorn locally). Every value is optional — sensible defaults apply.

# ---- Backend ----

# SQLAlchemy database URL. Defaults to a SQLite file next to the backend.
DATABASE_URL=sqlite:///./studentos.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Google Sheets API key. Without one, imports use the sheet's public
# CSV export, which works for sheets shared as "Anyone with the link can view".
GOOGLE_SHEETS_API_KEY=

# Default sheet imported when none is passed from the UI, and the sheet used
# by the background auto-sync job.
GOOGLE_SHEET_URL=

# Enable the APScheduler job that re-imports GOOGLE_SHEET_URL periodically.
AUTO_SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=60

# ---- Frontend ----

# Where the frontend reaches the API (Vite reads this at build/dev time).
VITE_API_URL=http://localhost:8000
